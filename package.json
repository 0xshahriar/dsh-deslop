{
  "name": "dsh-deslop",
  "version": "1.1.2",
  "private": false,
  "type": "module",
  "main": "lib/index.js",
  "description": "Remove AI slop from chat replies, clipboard text, and CLI tool output. Works as a CLI, a CLI-output wrapper, and a DSH plugin with a /deslop slash command.",
  "keywords": [
    "ai-slop",
    "deslop",
    "llm",
    "text-processing",
    "text-cleanup",
    "cli",
    "dsh",
    "dsh-plugin"
  ],
  "author": "Md. Shahriar Alam Shaon AKA 0xShahriar",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0xshahriar/dsh-deslop.git"
  },
  "bugs": {
    "url": "https://github.com/0xshahriar/dsh-deslop/issues"
  },
  "homepage": "https://github.com/0xshahriar/dsh-deslop#readme",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "bin": {
    "dsh-deslop": "./bin/dsh-deslop.js",
    "dsh-deslop-exec": "./bin/dsh-deslop-exec.js"
  },
  "files": [
    "lib",
    "bin",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "TROUBLESHOOTING.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "CODE_OF_CONDUCT.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "prepublishOnly": "npm test",
    "pack:check": "npm pack --dry-run"
  },
  "dshGo": {
    "v": 1,
    "title": "Deslop",
    "icon": "sparkle",
    "wants": [
      "clipboard",
      "draft",
      "message"
    ],
    "contributes": {
      "composer.actions": [
        {
          "id": "deslop-draft",
          "label": "Deslop",
          "icon": "sparkle"
        },
        {
          "id": "deslop-undo",
          "label": "Undo",
          "icon": "replay"
        }
      ],
      "message.actions": [
        {
          "id": "deslop-msg",
          "label": "Deslop reply",
          "icon": "sparkle"
        },
        {
          "id": "deslop-msg-copy",
          "label": "Copy clean",
          "icon": "copy"
        }
      ],
      "composer.strip": [
        {
          "id": "deslop-status",
          "icon": "sparkle",
          "text": "Deslop"
        }
      ],
      "panels": [
        {
          "id": "deslop-panel",
          "title": "Deslop",
          "icon": "sparkle",
          "placement": [
            "session.tab",
            "features",
            "chat.panel"
          ]
        }
      ],
      "composer.tools": [
        {
          "id": "deslop-clip-tool",
          "label": "De-clip",
          "icon": "paste"
        },
        {
          "id": "deslop-tool",
          "label": "Deslop",
          "icon": "sparkle",
          "panel": "deslop-panel"
        }
      ],
      "session.actions": [
        {
          "id": "deslop-session-export",
          "label": "Export clean",
          "icon": "download"
        }
      ]
    }
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./engine": {
      "default": "./lib/engine.js"
    },
    "./rules": {
      "default": "./lib/rules.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false
}
